# Clerk Authentication
# Get these values from https://dashboard.clerk.com

# Publishable Key (public, safe to expose)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE

# Secret Key (keep secret)
CLERK_SECRET_KEY=sk_test_YOUR_KEY_HERE

# Clerk Webhook Secret (for webhook events)
CLERK_WEBHOOK_SECRET=whsec_YOUR_SECRET_HERE

# Optional: Custom domain (if using custom domain)
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/auth-selection
# NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/auth-selection
